# ─── Flask Configuration ──────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=your_dev_secret_key_here

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Database Configuration ───────────────────────────────────────────────────
# Option A: SQLite (default for local dev — zero config)
# Leave DATABASE_URL blank and SQLite is used automatically (app.db)
DATABASE_URL=

# Option B: PostgreSQL (recommended for production)
# Uncomment and fill in when using the postgres service in docker-compose.yml
# DATABASE_URL=postgresql://placementpro:placementpro_secret@postgres:5432/placementpro

# PostgreSQL credentials (used by the postgres service in docker-compose.yml)
POSTGRES_USER=placementpro
POSTGRES_PASSWORD=placementpro_secret
POSTGRES_DB=placementpro

# ─── Redis Distributed Cache ──────────────────────────────────────────────────
# Option A: No Redis (default) — uses in-process cachetools TTLCache
# Leave REDIS_URL blank and cachetools is used automatically
REDIS_URL=

# Option B: Redis (for multi-instance / horizontal scaling)
# Uncomment when using the redis service in docker-compose.yml
# REDIS_URL=redis://redis:6379/0

# ─── AI / NLP Engine ─────────────────────────────────────────────────────────
# No API keys required — the NLP engine runs 100% locally via sentence-transformers

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
# Leave blank to disable — the app works fine without it
# Get your DSN from https://sentry.io/
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=2.0.0

# ─── Cache TTLs (seconds) ─────────────────────────────────────────────────────
# Override in staging/prod to tune performance
# Applies to both cachetools and Redis backends
CACHE_TTL_PREDICTION=600
CACHE_TTL_COMPANIES=900
CACHE_TTL_SKILL_GAP=600
CACHE_TTL_ROADMAP=1200
CACHE_MAX_SIZE=256
