# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=your_dev_secret_key_here

# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Neuro-Symbolic Service
# No API keys required. The NLP engine runs 100% locally.

# Database Configuration
# Leave blank to use local SQLite (app.db)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Sentry Error Tracking (Week 3)
# Leave blank to disable — app works fine without it
# Get your DSN from https://sentry.io/
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=2.0.0

# Cache TTLs in seconds (Week 3)
# Override in staging/prod to tune performance
CACHE_TTL_PREDICTION=600
CACHE_TTL_COMPANIES=900
CACHE_TTL_SKILL_GAP=600
CACHE_TTL_ROADMAP=1200
CACHE_MAX_SIZE=256
